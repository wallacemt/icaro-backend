generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model user {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String   @unique
  password   String
  avatar     String?
  about      String
  occupation String
  birthDate  DateTime
  cvLinkPT   String?
  cvLinkEN   String?
  secretWord String?
}
